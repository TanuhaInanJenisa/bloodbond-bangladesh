# BloodBond Bangladesh: Supabase Environment Configuration
# Copy this file to .env.local and replace with your actual Supabase project keys

# Supabase API URL (Found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe for client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (NEVER expose to frontend; for backend/edge use only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
